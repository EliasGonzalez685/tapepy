# Copiá este archivo a ".env" (NO subir el .env real a git) y completá.
# El .env real se carga con `source .env` antes de correr k6, o
# pasando cada variable con -e en el comando (ver README.md).

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica

# Cuenta DEDICADA a pruebas de carga -- no uses la cuenta de un socio
# real. Si no tenés una, creá un conductor de prueba en una parada de
# prueba (ver README.md, paso 1).
TEST_EMAIL=carga.prueba@tapepy.test
TEST_PASSWORD=

# uuid de esa cuenta de prueba y de la parada de prueba (los sacás con
# un SELECT en el dashboard de Supabase o pidiéndomelos a mí).
TEST_USER_ID=
TEST_PARADA_ID=

# Opcional: qr_token de un carnet vigente, para sumar la página pública
# de verificación a la mezcla de pruebas.
TEST_QR_TOKEN=

# Tu tope real de usuarios esperados. La prueba de carga sube hasta acá
# y la de estrés sigue subiendo por encima para encontrar el techo real.
TOPE_VUS=300
